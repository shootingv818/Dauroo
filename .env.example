# =========================================================================== #
# Dauroo — سرویس چند-مشتری ایتا
# این فایل را به .env کپی کن و پرش کن.
# =========================================================================== #

# ---- تلگرام (اجباری) ----
# API_ID / API_HASH از my.telegram.org
API_ID=
API_HASH=

# دو ربات جدا از @BotFather. یک کدبیس، دو پروسه (main.py را ببین).
OWNER_BOT_TOKEN=
CUSTOMER_BOT_TOKEN=

# تنها کاربری که به پنل مالک راه دارد. دکمه‌ی 🆘 پشتیبانی در ربات مشتری هم به
# پیوی همین آیدی باز می‌شود، پس کانال پشتیبانی جدا لازم نیست.
OWNER_ID=

# نقش این پروسه: owner یا customer
MODE=owner

# ---- گروه لاگ ----
# همه‌ی کارهای مشتری‌ها اینجا آینه می‌شود. اول ربات‌ها را ادمین گروه کن.
# آیدی گروه منفی است، مثل -1001234567890
LOG_GROUP_ID=

# لاگ سطح ۲: ناوبری منو را هم لاگ کن. پیش‌فرض خاموش، چون ۱۵ مشتری روزی حدود ۷۵۰
# پیام «منو باز کرد» می‌سازند و مهم‌ها گم می‌شوند. برای دنبال‌کردن یک مشکل خاص
# روشنش کن، بعد خاموش.
LOG_NAV=0

# ---- ضد-اسپم ----
# بیش از RATE_LIMIT_MAX اکشن شمرده‌شده در RATE_LIMIT_WINDOW ثانیه ⇒ مسدودیِ
# دائمی تا وقتی مالک دستی آزاد کند. ناوبری خالص شمرده نمی‌شود، وگرنه مشتری‌ای که
# فقط پنل را می‌گردد خودش را مسدود می‌کند.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=60
# در این نسبت از سقف، هشدار به گروه لاگ برود تا مشتری خوبی که نزدیک سقف است
# **قبل** از مسدودشدن دیده شود.
RATE_LIMIT_WARN_AT=0.75
# کارت مسدودی چند اکشن را فهرست کند. همین فهرست است که «کوبیدن روی یک دکمه» را از
# «مشتری واقعی که گیر افتاده» جدا می‌کند — و چون مسدودی دائمی است، مهم است.
BLOCK_CARD_ACTIONS=8

# ---- سقف‌های هر مشتری ----
ACCOUNT_CAP=40
# سهمیه روی **افزودن اکانت** است، نه ارسال: هر لاگین یک کروم را تا LOGIN_TTL
# ثانیه اشغال می‌کند، ولی ارسال با موتور سریع هیچ مرورگری مصرف نمی‌کند. پس سهمیه
# روی همان منبعِ کم و گران گذاشته شده. ۱۰ در روز × ۴ روز = دقیقاً سقف ۴۰ اکانت.
DAILY_ADD_QUOTA=10
# پنجره‌ی غلتان (ثانیه). غلتان است نه تقویمی: افزودن یازدهم وقتی مجاز می‌شود که
# قدیمی‌ترینِ ۱۰ تای قبلی از این پنجره بیرون رفته باشد — و همان عدد است که در
# پیام «سهمیه بعدی: ۶ ساعت دیگر» نشان داده می‌شود.
ADD_QUOTA_WINDOW=86400
# ارسال **سقف روزانه ندارد**. ترمزها: سقف اکانت، تعداد مخاطبین، صف مرورگر، و
# محدودیت‌های خودِ ایتا.
FILE_MAX_MB=20
SEND_MAX_ACCOUNTS=3

# ---- لاگین ----
# یک عدد برای همه‌ی مسیرهای لاگین. انتظارِ کد **داخل** اجاره‌ی pool است، پس وقتی
# این تایم‌اوت می‌زند مرورگر آزاد می‌شود و یک لاگین رهاشده کرومی را قفل نمی‌کند.
LOGIN_TTL=320

# ---- دروازه‌ی پذیرش مرورگر ----
# چند جاب هم‌زمان می‌توانند مرورگر بگیرند. این یک دروازه‌ی واقعی است:
# MKWL_POOL_MAX_OPEN فقط سقف سشن‌های **گرمِ آماده** است و جلوی یک لانچ جدید را
# نمی‌گیرد، پس بدون این، N مشتری یعنی N کروم و مرگ هاست. روی ۱۲ گیگ، ۳ راحت است.
BROWSER_SLOTS=3

# ---- موتور (پیش‌فرض؛ از پنل مالک زنده عوض می‌شود) ----
# bridge = موتور مرورگر (امن، پشتیبان دارد) · hybrid = موتور سریع (HTTPS)
ENGINE=bridge
# موتور سریع باید صریح باز شود، چون پشتیبان per-recipient ندارد.
MKWL_ENABLE_DIRECT=1

# ---- مرورگر ----
# جاب‌ها headless اجرا می‌شوند (سریع‌تر و کم‌رم‌تر). تصویر/فونت/مدیا abort می‌شوند.
MKWL_HEADED_JOBS=0
MKWL_LIGHT_ASSETS=1
# چند مرورگر گرم بمانند. روی ۱۲ گیگ، ۳ منطقی است (هر کروم ۰.۷ تا ۱ گیگ).
MKWL_POOL_MAX_OPEN=3
# Warm Path: صفحه‌ی بوت‌شده را دوباره استفاده کن به‌جای ناوبری مجدد. یک نشستِ
# مشتری را از ۵ بوت به ۱ بوت می‌رساند.
MKWL_WARMPATH=1

# ---- سرعت ارسال ----
TEXT_SEND_DELAY=3
SEND_CONCURRENCY=1
CONTACT_CREATE_DELAY=0.2
STOP_ON_LIMIT=1

# ---- مسیرها ----
DATA_DIR=./data
PROFILES_DIR=./profiles
ARTIFACTS_DIR=./artifacts

# ---- اختیاری ----
PING_HOST=majid.eitaa.com
BOT_VERSION=1.0
